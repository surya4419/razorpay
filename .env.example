# Razorpay Test-Mode Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/razorpay_recovery)
# If empty or unavailable, embedded persistent storage in ./server/data/db will be used automatically
MONGODB_URI=mongodb://localhost:27017/razorpay_recovery

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
